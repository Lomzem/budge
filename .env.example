# Every environment variable Budge uses, with the store it lives in. Names only:
# values never go in a repo file. Owner copies live in the password manager.

# --- Convex env: `bunx convex env set NAME value`, once per deployment ---
# Plaid API credentials (Sandbox outside production, Trial in production)
PLAID_CLIENT_ID=
PLAID_SECRET=
# AES-GCM key that encrypts Plaid access tokens at rest
BUDGE_TOKEN_KEY=
# Clerk user ID of the only person allowed in
BUDGE_OWNER_SUBJECT=
# Issuer of the Clerk instance paired with this deployment
CLERK_JWT_ISSUER_DOMAIN=

# --- Vercel env: Production and Preview environments ---
PUBLIC_CONVEX_URL=
PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Production deploy key in Production, preview deploy key in Preview
CONVEX_DEPLOY_KEY=

# --- .env.local: written by `bunx convex dev` for the local backend ---
CONVEX_DEPLOYMENT=
PUBLIC_CONVEX_URL=
PUBLIC_CONVEX_SITE_URL=
