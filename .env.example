# Every environment variable Budge uses, with the store it lives in. Names only:
# values never go in a repo file. Owner copies live in the password manager.

# --- Convex env: `bunx convex env set NAME value`, once per deployment ---
# Declared in convex/convex.config.ts; a deployment refuses code until the required ones are set.
# Plaid API credentials (Sandbox outside production, Trial in production)
PLAID_CLIENT_ID=
PLAID_SECRET=
# AES-GCM key that encrypts Plaid access tokens at rest
BUDGE_TOKEN_KEY=
# Clerk user ID (`user_…`) of the only person allowed in
BUDGE_OWNER_SUBJECT=
# Issuer of the Clerk instance paired with this deployment (its Frontend API URL)
CLERK_JWT_ISSUER_DOMAIN=
# Set to any value on the production deployment only; `seed:run` refuses to run where it is set
BUDGE_PRODUCTION=

# --- Vercel env: Production and Preview environments ---
PUBLIC_CONVEX_URL=
PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Production deploy key in Production, preview deploy key in Preview
CONVEX_DEPLOY_KEY=

# --- .env.local: the first three are written by `bunx convex dev` for the local backend ---
CONVEX_DEPLOYMENT=
PUBLIC_CONVEX_URL=
PUBLIC_CONVEX_SITE_URL=
# Added by hand: the Clerk development instance's keys
PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- GitHub Actions secrets: the e2e job, against the Clerk development instance only ---
CLERK_DEV_PUBLISHABLE_KEY=
CLERK_DEV_SECRET_KEY=
CLERK_DEV_JWT_ISSUER_DOMAIN=
# The one hand-made Clerk test user: its user ID (made owner of CI's local backend) and email
E2E_CLERK_USER_ID=
E2E_CLERK_USER_EMAIL=
