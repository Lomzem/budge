{
	"name": "budge",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "bun@1.4.4",
	"engines": {
		"node": "24.x"
	},
	"scripts": {
		"dev": "vite dev",
		"dev:backend": "convex dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "(svelte-kit sync || echo '') && (lefthook install || echo '')",
		"typecheck": "bun run typecheck:app && bun run typecheck:convex",
		"typecheck:app": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"typecheck:convex": "effect-tsgo tsc@7.0.2 --project convex/tsconfig.json",
		"lint": "eslint --max-warnings 0 .",
		"lint:ui": "eslint --config eslint.ui.config.js --max-warnings 0 .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"test:e2e:local": "bun e2e/run-local.ts"
	},
	"dependencies": {
		"convex": "1.48.0",
		"convex-svelte": "0.15.1",
		"effect": "4.0.6",
		"svelte-clerk": "1.2.0"
	},
	"devDependencies": {
		"@clerk/testing": "2.2.52",
		"@convex-dev/eslint-plugin": "5.0.0",
		"@edge-runtime/vm": "5.0.0",
		"@effect/language-service": "0.87.5",
		"@effect/tsgo": "0.62.0",
		"@effect/vitest": "4.0.6",
		"@eslint/js": "10.0.1",
		"@fontsource-variable/inter": "5.3.0",
		"@internationalized/date": "3.12.4",
		"@lucide/svelte": "1.62.0",
		"@playwright/test": "1.64.1",
		"@shadcn/lint": "0.2.3",
		"@sveltejs/adapter-vercel": "6.3.4",
		"@sveltejs/kit": "2.70.3",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "24.19.2",
		"bits-ui": "2.20.2",
		"cn": "0.5.0",
		"convex-test": "0.0.66",
		"eslint": "10.13.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.23.1",
		"globals": "17.13.0",
		"lefthook": "2.2.2",
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "4.1.1",
		"prettier-plugin-tailwindcss": "0.8.1",
		"shadcn-svelte": "1.7.1",
		"svelte": "5.57.3",
		"svelte-check": "4.7.7",
		"svelte-eslint-parser": "1.10.0",
		"tailwind-variants": "3.3.1",
		"tailwindcss": "4.3.3",
		"tw-animate-css": "1.4.0",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.1",
		"vite": "8.3.5",
		"vitest": "5.0.5"
	}
}
